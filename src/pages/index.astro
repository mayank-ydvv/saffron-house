---
import Base from '../layouts/Base.astro';
import { menu, chefPicks } from '../lib/data';
import { formatPrice } from '../lib/format';
---

<Base>
  <section class="wrap flex min-h-svh flex-col justify-center gap-6 pt-24">
    <p class="eyebrow">Phase 2</p>
    <h1 class="text-hero">A royal table, reimagined.</h1>
    <p class="text-muted">{menu.length} dishes · {chefPicks.length} chef’s picks · from {formatPrice(Math.min(...menu.map((m) => m.price)))}</p>
  </section>
</Base>
