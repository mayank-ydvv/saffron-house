---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { content } from '../data/content';
import { regions, testimonials } from '../lib/data';
import { img, WIDTHS } from '../lib/images';

const { about, chef } = content;
const regionList = Object.values(regions);
---

<Base
  title="About"
  description="Meet Chef Arjun Rao and the Saffron House kitchen: our philosophy, the four regions we cook from, and the growers and fishing families we source from."
>
  <header class="wrap pt-32 pb-16 sm:pt-40">
    <p class="eyebrow">{about.eyebrow}</p>
    <span class="rule mt-4" aria-hidden="true"></span>
    <h1 class="mt-6 max-w-3xl text-display text-cream">{about.title}</h1>
    <p class="mt-6 max-w-2xl text-lg text-muted">{about.intro}</p>
  </header>

  <section class="section pt-0" aria-labelledby="chef-heading">
    <div class="wrap grid items-center gap-14 lg:grid-cols-[0.9fr_1.1fr] lg:gap-24">
      <figure class="aspect-[4/5] overflow-hidden">
        <Image
          src={img(chef.portrait)}
          widths={WIDTHS}
          sizes="(min-width: 64rem) 40vw, 100vw"
          alt={chef.portraitAlt}
          loading="eager"
          fetchpriority="high"
          class="h-full w-full object-cover"
        />
      </figure>
      <div>
        <SectionHeading id="chef-heading" eyebrow={chef.eyebrow} title={`Chef ${chef.name}`} />
        {chef.bio.map((p) => <p class="reveal mt-6 text-lg text-cream/85">{p}</p>)}
        <blockquote class="reveal mt-10 border-l-2 border-saffron pl-6">
          <p class="font-display text-title text-cream">“{chef.quote}”</p>
        </blockquote>
      </div>
    </div>
  </section>

  <section class="section bg-char" aria-labelledby="philosophy-heading">
    <div class="wrap">
      <SectionHeading id="philosophy-heading" eyebrow="Kitchen philosophy" title="How we cook." />
      <ul class="mt-14 grid gap-10 md:grid-cols-3">
        {
          about.philosophy.map((p, i) => (
            <li class="reveal border-t border-brass/30 pt-6" style={`--d:${i}`}>
              <h3 class="font-display text-title text-cream">{p.title}</h3>
              <p class="mt-3 text-muted">{p.text}</p>
            </li>
          ))
        }
      </ul>
      <figure class="reveal mt-16 aspect-[3/2] overflow-hidden sm:aspect-[21/9]">
        <Image src={img(about.kitchenImage)} widths={WIDTHS} sizes="(min-width: 80rem) 80rem, 100vw" alt={about.kitchenAlt} loading="lazy" decoding="async" class="h-full w-full object-cover" />
      </figure>
    </div>
  </section>

  <section class="section" aria-labelledby="regions-heading">
    <div class="wrap">
      <SectionHeading id="regions-heading" eyebrow="The four regions" title="Where the recipes come from." />
      <div class="mt-14 grid gap-x-16 gap-y-14 md:grid-cols-2">
        {
          regionList.map((r, i) => (
            <article class="reveal" style={`--d:${i % 2}`} aria-labelledby={`region-${r.id}`}>
              <p class="font-display text-5xl text-brass/60" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </p>
              <h3 id={`region-${r.id}`} class="mt-3 font-display text-display text-cream">
                {r.name}
              </h3>
              <p class="mt-1 font-display text-title text-saffron">{r.tagline}</p>
              <p class="mt-5 text-cream/85">{r.story}</p>
              <dl class="mt-6 grid gap-4 border-t border-brass/20 pt-5 sm:grid-cols-2">
                <div>
                  <dt class="eyebrow">Signature dish</dt>
                  <dd class="mt-1.5 text-cream">{r.signatureDish}</dd>
                </div>
                <div>
                  <dt class="eyebrow">Spice notes</dt>
                  <dd class="mt-1.5 text-muted">{r.spiceNotes}</dd>
                </div>
              </dl>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section bg-char" aria-labelledby="sourcing-heading">
    <div class="wrap grid gap-14 lg:grid-cols-2 lg:gap-24">
      <div>
        <SectionHeading id="sourcing-heading" eyebrow="Sourcing" title={about.sourcing.title} />
        <p class="reveal mt-6 max-w-lg text-lg text-muted">{about.sourcing.intro}</p>
        <dl class="reveal mt-10">
          {
            about.sourcing.items.map((s) => (
              <div class="grid gap-1 border-b border-brass/15 py-4 sm:grid-cols-[0.8fr_1.2fr] sm:gap-6">
                <dt class="text-cream">{s.what}</dt>
                <dd class="text-muted">{s.from}</dd>
              </div>
            ))
          }
        </dl>
      </div>
      <figure class="reveal aspect-[4/5] overflow-hidden lg:aspect-auto">
        <Image src={img(about.sourcing.image)} widths={WIDTHS} sizes="(min-width: 64rem) 40vw, 100vw" alt={about.sourcing.alt} loading="lazy" decoding="async" class="h-full w-full object-cover" />
      </figure>
    </div>
  </section>

  <section class="section" aria-labelledby="press-heading">
    <div class="wrap">
      <SectionHeading id="press-heading" eyebrow="Press" title="In their words." />
      <ul class="mt-14 grid gap-10 md:grid-cols-2">
        {
          testimonials.map((t, i) => (
            <li class="reveal" style={`--d:${i % 2}`}>
              <figure class="h-full border-t border-brass/30 pt-6">
                <blockquote>
                  <p class="font-display text-title text-cream">“{t.quote}”</p>
                </blockquote>
                <figcaption class="mt-4 text-sm">
                  <span class="text-cream">{t.author}</span>
                  <span class="text-muted"> · {t.source}</span>
                </figcaption>
              </figure>
            </li>
          ))
        }
      </ul>
      <div class="reveal mt-16 flex flex-wrap gap-4">
        <Button href="/reserve">Reserve a Table</Button>
        <Button href="/menu" variant="outline">View Menu</Button>
      </div>
    </div>
  </section>
</Base>
