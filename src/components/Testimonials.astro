---
import ChevronLeft from '@lucide/astro/icons/chevron-left';
import ChevronRight from '@lucide/astro/icons/chevron-right';
import Pause from '@lucide/astro/icons/pause';
import Play from '@lucide/astro/icons/play';
import SectionHeading from './SectionHeading.astro';
import { content } from '../data/content';
import { testimonials } from '../lib/data';

const { testimonials: copy } = content;
const control =
  'inline-flex h-11 w-11 items-center justify-center rounded-full border border-brass/50 text-cream hover:border-saffron hover:text-saffron';
---

<section id="press" class="section cv-auto bg-char" aria-labelledby="press-title">
  <div class="wrap">
    <SectionHeading id="press-title" eyebrow={copy.eyebrow} title={copy.title} align="center" />

    <div data-carousel class="reveal mx-auto mt-14 max-w-3xl text-center" aria-roledescription="carousel" aria-label="Testimonials">
      <div data-live class="grid" aria-live="polite">
        {
          testimonials.map((t, i) => (
            <figure
              data-slide
              class="slide col-start-1 row-start-1"
              aria-roledescription="slide"
              aria-label={`${i + 1} of ${testimonials.length}`}
              data-active={i === 0 ? '' : undefined}
              aria-hidden={i === 0 ? undefined : 'true'}
              inert={i !== 0}
            >
              <blockquote>
                <p class="font-display text-title leading-snug text-cream sm:text-[2.25rem]">“{t.quote}”</p>
              </blockquote>
              <figcaption class="mt-6 text-sm">
                <span class="text-cream">{t.author}</span>
                <span class="text-muted"> · {t.source}</span>
              </figcaption>
            </figure>
          ))
        }
      </div>

      <div class="mt-10 flex items-center justify-center gap-3">
        <button type="button" data-action="prev" class={control}>
          <ChevronLeft size={20} stroke-width={1.5} aria-hidden="true" />
          <span class="sr-only">Previous testimonial</span>
        </button>
        <button type="button" data-action="toggle" class={control} hidden>
          <Pause size={18} stroke-width={1.5} data-icon="pause" aria-hidden="true" />
          <Play size={18} stroke-width={1.5} data-icon="play" class="hidden" aria-hidden="true" />
          <span class="sr-only" data-label>Pause rotation</span>
        </button>
        <button type="button" data-action="next" class={control}>
          <ChevronRight size={20} stroke-width={1.5} aria-hidden="true" />
          <span class="sr-only">Next testimonial</span>
        </button>
      </div>
    </div>

    <div class="mt-20 border-t border-brass/20 pt-10">
      <p class="eyebrow text-center">As featured in</p>
      <ul class="mt-6 flex flex-wrap items-center justify-center gap-x-10 gap-y-4">
        {copy.press.map((name) => <li class="font-display text-xl text-muted">{name}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .slide {
    opacity: 0;
    transition: opacity 0.9s var(--ease-out-expo);
  }
  .slide[data-active] {
    opacity: 1;
  }
</style>

<script>
  import '../scripts/carousel';
</script>
