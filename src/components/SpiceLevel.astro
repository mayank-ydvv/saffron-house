---
import type { Spice } from '../types';

interface Props {
  level: Spice;
  class?: string;
}
const { level, class: className } = Astro.props;
const labels = ['Not spicy', 'Mild', 'Medium', 'Hot'] as const;
---

{
  level > 0 && (
    <span class:list={['inline-flex items-center gap-0.5', className]} title={labels[level]}>
      {[1, 2, 3].map((n) => (
        <svg viewBox="0 0 24 24" class:list={['h-3.5 w-3.5', n <= level ? 'text-saffron' : 'text-brass/35']} aria-hidden="true">
          <path
            d="M5 20.5c7.5-.5 13-5.5 13.5-12.3.1-1.5-1.2-2.4-2.5-1.6C13.6 8.3 10.5 11.5 5 13c-2.7.8-2.8 7.7 0 7.5Z"
            fill={n <= level ? 'currentColor' : 'none'}
            stroke="currentColor"
            stroke-width="1.5"
          />
          <path d="M16.5 6.6c0-1.8.8-3 2.6-3.6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        </svg>
      ))}
      <span class="sr-only">Spice: {labels[level]}</span>
    </span>
  )
}
